{
  "name": "tiknil/backups",
  "description": "Custom backup management",
  "version": "0.4.1",
  "keywords": [
    "tiknil",
    "backups"
  ],
  "homepage": "https://github.com/tiknil/backups",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Giorgio Balduzzi",
      "email": "balduzzi.giorgio@tiknil.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "aws/aws-sdk-php": "^3.400",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "spatie/laravel-backup": "^9.0|^10.0"
  },
  "require-dev": {
    "laravel/pint": "^1.8",
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Tiknil\\Backups\\": "src"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tiknil\\Backups\\BackupsServiceProvider"
      ],
      "aliases": {
        "Backups": "Tiknil\\Backups\\BackupsFacade"
      }
    }
  }
}
